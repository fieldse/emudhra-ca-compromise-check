# Debian trixie (debian:trixie-20261020, multi-arch index digest) with the test tools from the official repository.
FROM docker.io/library/debian@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
RUN apt-get update && apt-get install -y --no-install-recommends \
      yara shellcheck openssl python3 python3-yaml ca-certificates flake8 black mypy \
    && rm -rf /var/lib/apt/lists/*
