# emudhra-ca.rules - Suricata 7 rules for the eMudhra G3 intermediate CA key compromise (October 2026).
# Matches certificates in TLS 1.2 and older handshakes. TLS 1.3 encrypts certificates, so these rules cannot see it.
# Source: https://github.com/fieldse/emudhra-ca-check  Revised 2026-10-31.

# 1. A chain carries one of the eight compromised intermediates, as issued by eMudhra or cross-signed by Sectigo.
#    Matches the public key's X coordinate, which both versions of each intermediate share.
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM DV TLS CA - G3B"; flow:established,to_client; tls.certs; content:"|E7 9E D9 C0 4A 97 73 C4 73 5E 51 11 1D A8 5A C2 BD 5E 64 AB 37 4B 80 E1 2C BC 20 38 EC 1E 4F 0E 3B 81 2F C9 85 9E 1E 67 AF B0 4E 2F 8B C9 7F 74|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626001; rev:1; metadata:created_at 2026_10_31, cert_type TLS;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM OV TLS CA - G3B"; flow:established,to_client; tls.certs; content:"|73 89 7A A0 EB 3C FD CA 8B 12 40 2F FA F0 AB C4 E1 21 2B AF 8D EE 77 8A C9 EE 2D 6D B8 3F AC 28 0C 5E 05 63 8A E7 A2 AC D7 1C 32 2A 8E 36 1C DE|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626002; rev:1; metadata:created_at 2026_10_31, cert_type TLS;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM EV TLS CA - G3B"; flow:established,to_client; tls.certs; content:"|25 DB A8 5A 64 D3 97 DA 0B 10 52 E9 EA 54 6E 48 7B EF EA 9C 9D 9D 68 A0 C5 EA DC FE EF 75 A6 9B B5 D6 FC 01 F4 2B FB CA 6E B4 0B CD 64 C0 76 7E|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626003; rev:1; metadata:created_at 2026_10_31, cert_type TLS;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM DV TLS CA - G3C"; flow:established,to_client; tls.certs; content:"|3A 7A 78 62 C8 C4 4D 32 4D DD 69 03 3A 67 82 C0 EF EE FE 40 55 E6 8A 12 3F A0 37 1B A3 BD 91 94 51 4E E1 72 A4 33 E3 63 0F 02 BD 18 80 37 D9 E5|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626004; rev:1; metadata:created_at 2026_10_31, cert_type TLS;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM OV TLS CA - G3C"; flow:established,to_client; tls.certs; content:"|13 82 51 CD 52 AC 92 98 C1 C8 AA D9 77 32 1D EB 97 E7 09 BD 0B 4C A0 AC A5 5D C8 AD 51 DC FC 9D 15 89 A1 59 7E 3A 51 20 E1 EF D6 31 C6 3E 18 35|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626005; rev:1; metadata:created_at 2026_10_31, cert_type TLS;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM EV TLS CA - G3C"; flow:established,to_client; tls.certs; content:"|2D 56 E8 29 A6 FB 82 C6 4A 46 97 D9 60 AF 95 1E 90 67 AE 91 F9 26 D3 43 06 DA 48 A8 AA EB 78 69 B6 A6 7E 6D 27 42 6E 04 42 AA 03 B3 6E 19 88 DF|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626006; rev:1; metadata:created_at 2026_10_31, cert_type TLS;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM OV CS CA - G3B"; flow:established,to_client; tls.certs; content:"|AA BB 0F B0 66 6A CF CF 01 FA D5 2B FC FD 4C 2B F2 CB 3C 34 97 DE 73 95 0E 58 19 B6 1F E6 95 09 87 41 C8 C4 91 43 9B 34 A0 43 1C AF FE 5B F9 B4|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626007; rev:1; metadata:created_at 2026_10_31, cert_type code_signing;)
alert tls any any -> any any (msg:"eMudhra compromised intermediate in TLS chain: EM OV CS CA - G3C"; flow:established,to_client; tls.certs; content:"|B9 F0 E0 63 47 02 A6 9C A6 AA DD 44 3C FD 62 C4 1B 9B A4 B2 09 24 69 7D 79 74 E7 69 1A 12 6F B9 6A FB 3E 34 C2 FD 3B C5 F4 83 06 1F 26 5D C2 A5|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626008; rev:1; metadata:created_at 2026_10_31, cert_type code_signing;)

# 2. The server certificate names one of the eight intermediates as its issuer.
#    Fires even when the server sends only the leaf.
alert tls any any -> any any (msg:"eMudhra TLS certificate issued by a compromised G3 intermediate"; flow:established,to_client; tls.cert_issuer; content:"CA - G3"; pcre:"/CN=EM (?:DV|OV|EV) (?:TLS|CS) CA - G3[BC](?:,|$)/"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:bad-unknown; priority:1; sid:1626009; rev:1; metadata:created_at 2026_10_31;)

# 3. A chain still includes emSign ECC Root CA - G3 or one of the two G3 issuing roots.
#    Expected from unmigrated legitimate sites until they reissue. Informational.
alert tls any any -> any any (msg:"eMudhra G3 root certificate in TLS chain: emSign ECC Root CA - G3"; flow:established,to_client; tls.certs; content:"|23 A5 0C B8 2D 12 F5 28 F3 B1 B2 DD E2 02 12 80 9E 39 5F 49 4D 9F C9 25 34 59 74 EC BB 06 1C E7 C0 72 AF E8 AE 2F E1 41 54 87 14 A8 4A B2 E8 7C|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:policy-violation; priority:3; sid:1626010; rev:1; metadata:created_at 2026_10_31;)
alert tls any any -> any any (msg:"eMudhra G3 root certificate in TLS chain: emSign Root TLS CA - G3"; flow:established,to_client; tls.certs; content:"|5F 0F DC 3F AB 57 16 C4 BE 83 F5 B3 06 1F A0 90 E2 EF A0 01 5E 86 37 DB 3E 3F 04 31 F4 19 78 84 2F B4 89 4F 10 3A 4F 26 58 EF D1 C1 74 32 D7 40|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:policy-violation; priority:3; sid:1626011; rev:1; metadata:created_at 2026_10_31;)
alert tls any any -> any any (msg:"eMudhra G3 root certificate in TLS chain: emSign Root CS CA - G3"; flow:established,to_client; tls.certs; content:"|4A 5F 64 33 90 F4 54 0F CE 83 BE 9D CF 95 F3 C3 58 67 19 0E 1F 49 1F 7D F7 7F EA 06 49 2F 23 8F 29 5D 05 4A 39 DC 87 0A 00 19 4E 18 16 7A 34 3C|"; reference:url,github.com/fieldse/emudhra-ca-check; classtype:policy-violation; priority:3; sid:1626012; rev:1; metadata:created_at 2026_10_31;)
